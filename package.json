{
  "name": "multi-provider-llm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/start.mjs",
    "start:api": "npm run build && node dist/server.js",
    "start:swagger": "node scripts/swagger-server.mjs",
    "swagger": "node scripts/swagger-server.mjs",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "test:recommendation": "npm run build && node --test test/integration/recommendation/recommendation.test.mjs",
    "load:test": "npm run build && node scripts/load-test.mjs",
    "load:redis": "npm run build && node scripts/load-redis-test.mjs",
    "load:multi": "npm run build && node scripts/load-multi-instance.mjs",
    "load:sustained": "npm run build && node scripts/load-sustained.mjs",
    "load:fairness": "npm run build && node scripts/load-fairness.mjs",
    "load:failure": "npm run build && node scripts/load-failure-recovery.mjs",
    "certification:batch-e": "node scripts/production-certification.mjs"
  },
  "engines": { "node": "23.8.0" },
  "dependencies": { "redis": "^5.8.2" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.7.0" }
}
