# Copy this file to .env and replace every placeholder.
# Never commit .env or real provider credentials.

NODE_ENV=development
PORT=3000
GATEWAY_API_KEY=replace-with-a-strong-local-secret

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
# Node.js Redis URL derived from the settings above.
REDIS_URL=redis://127.0.0.1:6379

# ============================================================
# Dynamic LLM provider accounts
# ============================================================
# Add as many numbered credentials as required.
# There is NO fixed account limit and numbering does not need to be contiguous.
# Example: _1, _2, _5, _10 is valid.
# The gateway automatically discovers these variables when
# LLM_GATEWAY_CONFIG is not set.

# Gemini
GEMINI_API_KEY_1=replace-with-gemini-account-1-key
GEMINI_API_KEY_2=replace-with-gemini-account-2-key
GEMINI_API_KEY_3=replace-with-gemini-account-3-key

# Groq
GROQ_API_KEY_1=replace-with-groq-account-1-key
GROQ_API_KEY_2=replace-with-groq-account-2-key

# OpenRouter
OPENROUTER_API_KEY_1=replace-with-openrouter-account-1-key
OPENROUTER_API_KEY_2=replace-with-openrouter-account-2-key

# Cloudflare
CLOUDFLARE_API_TOKEN_1=replace-with-cloudflare-account-1-token
CLOUDFLARE_API_TOKEN_2=replace-with-cloudflare-account-2-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# ============================================================
# Optional explicit gateway configuration
# ============================================================
# If LLM_GATEWAY_CONFIG is set, it takes precedence over dynamic
# environment discovery. Use explicit configuration when you need
# per-account models, capabilities, priorities, or quota limits.
#
# If it is NOT set, the gateway dynamically discovers:
# GEMINI_API_KEY_*
# GROQ_API_KEY_*
# OPENROUTER_API_KEY_*
# CLOUDFLARE_API_TOKEN_*
#
# Dynamic accounts receive provider defaults and round-robin routing.
#
# Optional HTTP request protection.
GATEWAY_REQUEST_BODY_LIMIT_BYTES=1048576

# Optional OpenRouter metadata.
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_NAME=Your App
