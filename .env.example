# Copy this file to .env and replace every placeholder.
# Never commit .env or real provider credentials.

NODE_ENV=development
PORT=3000
GATEWAY_API_KEY=replace-with-a-strong-local-secret

# Redis
# Host Node.js: redis://localhost:6379
# Docker Compose: compose.yaml overrides this to redis://redis:6379
REDIS_URL=redis://localhost:6379

# Provider credentials. Account configuration references these names.
GEMINI_ACCOUNT_1_API_KEY=replace-with-gemini-account-1-key
GEMINI_ACCOUNT_2_API_KEY=replace-with-gemini-account-2-key
GROQ_API_KEY=replace-with-groq-key
OPENROUTER_API_KEY=replace-with-openrouter-key
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# Required gateway account configuration.
# This example configures TWO Gemini accounts using separate credentials.
# Keep this value on one line when using .env.
LLM_GATEWAY_CONFIG={"version":1,"strategy":"round_robin","maxRetries":2,"cooldownMs":30000,"providers":[{"name":"gemini","enabled":true,"accounts":[{"id":"gemini-primary","provider":"gemini","credentialRef":"GEMINI_ACCOUNT_1_API_KEY","models":["gemini-2.5-flash"],"capabilities":["chat","streaming","structured_output","tool_calling","vision"],"priority":10,"enabled":true,"limits":{"rpm":60,"rpd":1000,"tpm":100000,"tpd":1000000}},{"id":"gemini-secondary","provider":"gemini","credentialRef":"GEMINI_ACCOUNT_2_API_KEY","models":["gemini-2.5-flash"],"capabilities":["chat","streaming","structured_output","tool_calling","vision"],"priority":20,"enabled":true,"limits":{"rpm":60,"rpd":1000,"tpm":100000,"tpd":1000000}}]}]}

# Optional HTTP request protection.
GATEWAY_REQUEST_BODY_LIMIT_BYTES=1048576

# Optional OpenRouter metadata.
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_NAME=Your App
