# Local development environment
# Copy to .env and replace placeholders with local values.
# Never commit .env or real provider credentials.

NODE_ENV=development
PORT=3000

# Gateway authentication
GATEWAY_API_KEY=replace-with-a-local-secret

# Redis
# Use localhost for a Node.js process running directly on the host.
# Docker Compose overrides this to redis://redis:6379 inside the gateway container.
REDIS_URL=redis://localhost:6379

# Provider credentials — uncomment only what you use.
GEMINI_API_KEY=replace-with-your-gemini-key
GROQ_API_KEY=replace-with-your-groq-key
OPENROUTER_API_KEY=replace-with-your-openrouter-key
CLOUDFLARE_API_TOKEN=replace-with-your-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id

# Optional gateway defaults
# GATEWAY_MAX_RETRIES=2
# GATEWAY_COOLDOWN_MS=30000
# GATEWAY_REQUEST_BODY_LIMIT_BYTES=1048576

# Optional JSON configuration consumed by loadConfigFromEnvironment().
# Keep secrets out of this JSON; use credentialRef instead.
# LLM_GATEWAY_CONFIG={"version":1,"strategy":"priority","providers":[]}
