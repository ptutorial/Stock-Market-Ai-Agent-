# Local development environment. Do not commit real secrets.
NODE_ENV=development
PORT=3000
GATEWAY_API_KEY=replace-with-a-strong-local-secret

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# LLM provider accounts
GEMINI_API_KEY_1=replace-with-gemini-account-1-key
GROQ_API_KEY_1=replace-with-groq-account-1-key
OPENROUTER_API_KEY_1=replace-with-openrouter-account-1-key
CLOUDFLARE_API_TOKEN_1=replace-with-cloudflare-account-1-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# Add additional numbered accounts as needed:
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# GROQ_API_KEY_2=...
# OPENROUTER_API_KEY_2=...
# CLOUDFLARE_API_TOKEN_2=...
